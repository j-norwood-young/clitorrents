{
  "name": "clitorrents",
  "version": "0.4.2",
  "description": "TUI torrent client",
  "type": "module",
  "bin": {
    "clitorrents": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/cli.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-norwood-young/clitorrents.git"
  },
  "bugs": {
    "url": "https://github.com/j-norwood-young/clitorrents/issues"
  },
  "homepage": "https://j-norwood-young.github.io/clitorrents/",
  "keywords": [
    "torrent",
    "tui",
    "cli",
    "webtorrent",
    "terminal",
    "mcp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.tsx",
    "daemon": "node dist/cli.js daemon",
    "stop": "node dist/cli.js stop",
    "status": "node dist/cli.js status",
    "mcp": "node dist/cli.js mcp",
    "search": "node dist/cli.js search",
    "download": "node dist/cli.js download",
    "help": "node dist/cli.js help",
    "docs": "serve docs -l 8765",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "test:e2e": "npm run build && tsx --test 'src/**/*.e2e.ts'",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-exclude='src/test/**' --test-coverage-exclude='src/**/*.test.*' --test-coverage-exclude='src/**/*.e2e.ts' 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "typecheck": "tsc",
    "mock-server": "tsx scripts/mock-torrent-server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^7.0.0",
    "parse-torrent": "^11.0.18",
    "react": "^19.2.3",
    "torrent-search-api": "^2.1.4",
    "webtorrent": "^2.8.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "ink-testing-library": "^4.0.0",
    "serve": "^14.2.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "node-datachannel@0.32.2": true,
    "esbuild@0.27.2": true
  }
}
